    "data",
    "mining",
    "datamining",
    "levenberg",
    "marquardt"
  ],
  "author": "Miguel Asencio <maasencioh@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mljs/levenberg-marquardt/issues"
  },
  "homepage": "https://github.com/mljs/levenberg-marquardt#readme",
  "dependencies": {
    "is-any-array": "^3.0.0",
    "ml-matrix": "^6.14.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "jest-matcher-deep-close-to": "^3.0.2",
    "ml-peak-shape-generator": "^5.4.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
